{
  "name": "wattnexa",
  "version": "0.1.0",
  "private": true,
  "description": "WattNexa — IoT electricity monitoring and smart energy management platform",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel -r --filter \"./apps/**\" run dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "db:generate": "pnpm --filter @wattnexa/database run generate",
    "db:migrate": "pnpm --filter @wattnexa/database run migrate",
    "db:seed": "pnpm --filter @wattnexa/database run seed",
    "db:reset": "pnpm --filter @wattnexa/database run reset",
    "simulate": "pnpm --filter @wattnexa/api run simulate",
    "docker:up": "docker compose up -d mariadb",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "express": "^5.3.0"
  }
}
