# ---------------------------------------------------------------------------
# WattNexa environment configuration
# Copy to .env and adjust. Never commit real secrets.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- API -------------------------------------------------------------------
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- Database (MariaDB) ----------------------------------------------------
DATABASE_URL=mysql://wattnexa:wattnexa@localhost:3307/wattnexa

# Preferred discrete database settings (override DATABASE_URL when all are set)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# --- Auth ------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-64-char-random-string
JWT_REFRESH_SECRET=replace-with-a-different-64-char-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
# lax = web and API on the same site (local / one domain).
# none = different sites (Vercel frontend + API on your own domain); forces Secure.
COOKIE_SAME_SITE=lax
BCRYPT_ROUNDS=10

# --- Email (Nodemailer) ----------------------------------------------------
# When SMTP_HOST is unset, emails are written to the log and kept in an
# in-memory outbox exposed at /api/v1/dev/outbox in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="WattNexa <no-reply@wattnexa.local>"

# --- MQTT (ESP32 telemetry) ------------------------------------------------
# Leave MQTT_ENABLED=false to run without a broker. The adapter then reports
# itself as disabled instead of pretending telemetry is arriving.
# Production must use TLS: MQTT_URL=mqtts://broker.example.com:8883
# Topic contract (see docs/HARDWARE.md):
#   <prefix>/devices/<serial>/telemetry | status | commands
MQTT_ENABLED=false
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=wattnexa

# --- Telemetry -------------------------------------------------------------
# "simulated" runs the built-in simulator. "hardware" only accepts signed
# device telemetry. Both can coexist per-device; simulated rows are always
# stored with source='simulated'.
SENSOR_MODE=simulated
OFFLINE_THRESHOLD_SECONDS=120

# --- WattBot (AI) ----------------------------------------------------------
# Provider: openai | anthropic | none. When none/unset, or when the provider key
# is missing, WattBot answers from the same verified data using deterministic
# rules. Keys are read only by the API — never expose them to the web bundle.
WATTBOT_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# Optional overrides for a gateway/proxy, or the local mock in apps/api/scripts.
# Leave blank to use the provider's official endpoint.
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=
# Hard timeout per provider call; on timeout the answer falls back to data-only.
WATTBOT_TIMEOUT_MS=20000
# Prior messages sent as context (older turns stay stored but are not resent).
WATTBOT_CONTEXT_MESSAGES=10
WATTBOT_MAX_TOKENS=700
WATTBOT_TEMPERATURE=0.3
# Optional semantic retrieval for approved product documentation. When this is
# none (or the key is missing), WattBot uses lexical retrieval instead.
# Re-index after changing the corpus/model: pnpm --filter @wattnexa/api kb:reindex
WATTBOT_EMBEDDING_PROVIDER=none
WATTBOT_EMBEDDING_MODEL=text-embedding-3-small
WATTBOT_RETRIEVAL_MIN_SCORE=0.28

# --- Uploads / reports -----------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880

# --- Frontend (Vite) -------------------------------------------------------
VITE_API_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000
# Public origin used for canonical links, sitemap.xml, robots.txt and social
# previews. Set this to the production domain (https://your-domain.com) in the
# hosting environment before a production build. Local builds fall back to
# http://localhost:5173 when it is unset.
VITE_SITE_URL=http://localhost:5173
